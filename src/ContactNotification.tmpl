<!-- Notification sent to Abdullah for each contact form message (EmailJS template). -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#09090b" style="background-color: #09090b; margin: 0; padding: 0;">
  <tr>
    <td align="center" style="padding: 40px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; font-family: 'Geist', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #fafafa;">

        <!-- Header -->
        <tr>
          <td style="padding: 0 4px 28px 4px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="44" valign="middle">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="40" height="40" align="center" valign="middle" bgcolor="#fafafa" style="width: 40px; height: 40px; border-radius: 50%; background-color: #fafafa; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; font-weight: 700; color: #09090b; letter-spacing: -0.02em;">AR</td>
                    </tr>
                  </table>
                </td>
                <td valign="middle" style="padding-left: 12px;">
                  <div style="font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: #fafafa;">Abdullah Rather</div>
                  <div style="font-size: 13px; color: #a1a1aa; margin-top: 2px;">AI Software Engineer · PHP Backend / Full-Stack</div>
                </td>
                <td align="right" valign="middle">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td bgcolor="#111113" style="background-color: #111113; border: 1px solid #27272a; border-radius: 999px; padding: 6px 12px; font-size: 12px; color: #a1a1aa; white-space: nowrap;">
                        <span style="color: #818cf8;">&#9679;</span>&nbsp; New message
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Accent line -->
        <tr>
          <td height="2" bgcolor="#818cf8" style="height: 2px; line-height: 2px; font-size: 0; background-color: #818cf8; background-image: linear-gradient(90deg, #818cf8, #c084fc); border-radius: 2px;">&nbsp;</td>
        </tr>

        <!-- Sender -->
        <tr>
          <td style="padding: 40px 4px 28px 4px;">
            <p style="margin: 0; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #a1a1aa;"><span style="color: #818cf8;">&mdash;&mdash;</span>&nbsp; Portfolio contact form</p>
            <h1 style="margin: 16px 0 0 0; font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: -0.035em; color: #fafafa;">{{from_name}}</h1>
            <p style="margin: 10px 0 0 0; font-size: 15px;"><a href="mailto:{{from_email}}" style="color: #818cf8; text-decoration: none;">{{from_email}}</a></p>
            <p style="margin: 6px 0 0 0; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; color: #71717a;">{{time}} &middot; {{user_timezone}}</p>

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
              <tr>
                <td bgcolor="#fafafa" style="background-color: #fafafa; border-radius: 999px;">
                  <a href="mailto:{{from_email}}?subject=Re: {{subject}}" target="_blank" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #09090b; text-decoration: none;">Reply to {{from_name}} &rarr;</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Message -->
        <tr>
          <td bgcolor="#18181b" style="background-color: #18181b; border: 1px solid #27272a; border-radius: 20px; padding: 28px;">
            <p style="margin: 0; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #71717a;">Subject</p>
            <p style="margin: 6px 0 20px 0; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: #fafafa;">{{subject}}</p>

            <p style="margin: 0; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #71717a;">Message</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 8px;">
              <tr>
                <td bgcolor="#111113" style="background-color: #111113; border: 1px solid #27272a; border-left: 2px solid #818cf8; border-radius: 12px; padding: 18px 20px; font-size: 16px; line-height: 1.65; color: #e4e4e7; white-space: pre-wrap;">{{message}}</td>
              </tr>
            </table>
          </td>
        </tr>

        <tr><td height="16" style="height: 16px; line-height: 16px; font-size: 0;">&nbsp;</td></tr>

        <!-- Time references -->
        <tr>
          <td bgcolor="#18181b" style="background-color: #18181b; border: 1px solid #27272a; border-radius: 20px; padding: 24px 28px;">
            <p style="margin: 0 0 14px 0; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #a1a1aa;"><span style="color: #818cf8;">&mdash;&mdash;</span>&nbsp; Time references</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 13px;">
              <tr>
                <td width="120" style="padding: 8px 0; border-top: 1px solid #27272a; color: #71717a;">Their time</td>
                <td style="padding: 8px 0; border-top: 1px solid #27272a; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; color: #d4d4d8;">{{time}}</td>
              </tr>
              <tr>
                <td width="120" style="padding: 8px 0; border-top: 1px solid #27272a; color: #71717a;">Your time</td>
                <td style="padding: 8px 0; border-top: 1px solid #27272a; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; color: #d4d4d8;">{{time_recipient}} <span style="color: #71717a;">({{recipient_location}})</span></td>
              </tr>
              <tr>
                <td width="120" style="padding: 8px 0; border-top: 1px solid #27272a; color: #71717a;">UTC</td>
                <td style="padding: 8px 0; border-top: 1px solid #27272a; font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; color: #d4d4d8;">{{time_utc}}</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="padding: 32px 4px 0 4px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top: 1px solid #27272a; padding-top: 20px; font-size: 12px; line-height: 1.6; color: #71717a;">
                  Sent from the contact form on <a href="https://abdullahrather.com" target="_blank" style="color: #a1a1aa; text-decoration: none;">abdullahrather.com</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
